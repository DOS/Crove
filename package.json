{
  "name": "crove-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Crove - the open-source, AI-native Business OS for solo founders and SMEs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crove/kernel-server --filter @crove/app dev",
    "dev:web": "pnpm --filter @crove/web dev",
    "build": "pnpm -r --filter=!@crove/web build",
    "typecheck": "pnpm -r --filter=!@crove/web typecheck",
    "lint": "oxlint --deny-warnings apps/kernel apps/app packages modules",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "docs:check": "node tools/docs-check.mjs",
    "db:migrate": "pnpm --filter @crove/db migrate",
    "db:auth-grants": "pnpm --filter @crove/kernel-server auth-grants",
    "prepare": "node tools/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
