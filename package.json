{
  "name": "crove-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Crove - The Modern Business OS for Solo Founders & SMEs",
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "pnpm --filter @crove/web dev",
