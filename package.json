{
  "name": "crove-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Crove - the open-source, AI-native Business OS for solo founders and SMEs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crove/kernel-server --filter @crove/extract --filter @crove/app dev",
    "dev:web": "pnpm --filter @crove/web dev",
    "build": "pnpm -r --filter=!@crove/web build",
    "typecheck": "pnpm -r --filter=!@crove/web typecheck && tsc --noEmit -p tools/tsconfig.json",
    "lint": "oxlint --deny-warnings apps/kernel apps/extract apps/app packages modules && node tools/ui-colors.mjs",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "ai:conformance": "vitest run --project ai conformance",
    "ai:eval": "vitest run --project ai extraction-eval --silent=false",
    "docs:check": "node tools/docs-check.mjs",
    "db:migrate": "pnpm --filter @crove/db migrate",
    "db:types": "node tools/db-types.mjs",
    "db:auth-grants": "pnpm --filter @crove/kernel-server auth-grants",
    "alert:test": "node --env-file-if-exists=.env apps/kernel/src/main.ts prober --test-alert",
    "prepare": "node tools/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "kanel": "catalog:",
    "kanel-kysely": "catalog:",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
