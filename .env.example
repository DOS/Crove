# Copy to .env and change every secret before exposing Crove to anyone else.

# Public URL users open (also used for auth redirects)
PUBLIC_URL=http://localhost:8080
PORT=8080

# Database (PostgreSQL 17)
POSTGRES_PASSWORD=change-me-postgres
CROVE_APP_DB_PASSWORD=change-me-app
CROVE_WORKER_DB_PASSWORD=change-me-worker
CROVE_PROBER_DB_PASSWORD=change-me-prober
AUTH_DB_PASSWORD=change-me-auth
# Reset each pooled connection's session before reuse. Keep true with direct connections; set false only behind a
# transaction-mode pooler (PgBouncer, Supavisor), whose own reset governs there.
DB_RESET_ON_RELEASE=true

# Supabase Auth (bundled). At least 32 random characters.
AUTH_JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Require email confirmation (needs a real SMTP server below)
AUTH_AUTOCONFIRM=false
# Anyone who can reach PUBLIC_URL can sign up and use your AI budget. Set true after creating your accounts.
AUTH_DISABLE_SIGNUP=false
# Approving entries and changing members need MFA in the last 5 minutes (policy P11). off works on localhost only.
AUTH_STEP_UP=required
# Emails Supabase Auth sends (sign-up confirmation, recovery, magic link and OTP codes, email change): at most
# AUTH_RATE_LIMIT_EMAIL_SENT per hour for the whole deployment (size it to your SMTP provider's quota), at most
# AUTH_EMAIL_CLIENT_LIMIT_PER_HOUR per client address (IPv6: per /64) and one per recipient every
# AUTH_EMAIL_ADDRESS_INTERVAL_SECONDS. Over a limit: 429. On a public URL Crove refuses to start unless it takes at
# least 10 client addresses to use up the budget (client limit x 10 <= budget). Behind a reverse proxy set
# TRUSTED_PROXY_HOPS, or every client shares the proxy's address and one budget.
AUTH_RATE_LIMIT_EMAIL_SENT=100
AUTH_EMAIL_CLIENT_LIMIT_PER_HOUR=5
AUTH_EMAIL_ADDRESS_INTERVAL_SECONDS=60
# Requests per 5 minutes per client address on sign-up, recovery, OTP, resend and user updates (Supabase Auth).
AUTH_RATE_LIMIT_OTP=30
# How many orgs one account may create: in any 24 hours, and in total (closed orgs count). Over the limit: 429.
ORG_CREATE_LIMIT_PER_DAY=5
ORG_CREATE_LIMIT_TOTAL=20
# How often one org may change its inbound email address: in any 24 hours, and in total. Over the limit: 429.
INBOUND_ROTATE_LIMIT_PER_DAY=3
INBOUND_ROTATE_LIMIT_TOTAL=50
# Refused requests per hour that still get their own audit row: per user, and per org. Past them a refusal is only
# counted (the first refusal of each kind is always audited). Each user keeps a reserve the org limit cannot take, and
# security-relevant refusals (FORBIDDEN, MFA step-up, not found) are bounded by the user limit only. The counts are
# kept for REFUSAL_TALLY_RETENTION_DAYS.
REFUSAL_AUDIT_LIMIT_PER_ACTOR=50
REFUSAL_AUDIT_LIMIT_PER_ORG=500
REFUSAL_AUDIT_RESERVE_PER_ACTOR=10
REFUSAL_AUDIT_WINDOW_SECONDS=3600
REFUSAL_TALLY_RETENTION_DAYS=7
# Requests per minute per signed-in user, per API process. Over the limit: 429 with Retry-After. 0 turns it off.
API_RATE_LIMIT_PER_MINUTE=600
# Outbound mail for Supabase Auth (confirmation, magic link, recovery) and Crove (member invites). Port 465 is
# implicit TLS; on other ports with SMTP_USER and SMTP_PASS the server must offer STARTTLS. Without SMTP_HOST (outside
# docker compose, which defaults to Mailpit) Crove sends no invite mail and the inviter passes the link on.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Modules to run, comma-separated (kernel is always on). Empty runs every module: kernel,finance.
CROVE_MODULES=

# AI for PDF and image invoices: any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, DOS.AI, ...).
# Leave empty to read e-invoice XML only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# crove-extract, the parsing sandbox the worker sends files and emails to. docker compose sets it; for
# `pnpm dev`, the extract dev server listens here.
EXTRACT_URL=http://127.0.0.1:8090

# Inbound email: invoices sent to <org token>@INBOUND_DOMAIN are delivered by your mail worker
# to POST /api/inbound/email with "Authorization: Bearer <INBOUND_SECRET>" (raw MIME body).
INBOUND_DOMAIN=
# At least 32 random characters.
INBOUND_SECRET=
# Behind a TLS reverse proxy: how many proxies append to X-Forwarded-For (used for the sign-in, sign-up, recovery
# and email rate limits, which are per client address).
TRUSTED_PROXY_HOPS=0

# File storage: local (the `files` volume) or s3 (any S3-compatible store). With s3 the api and worker
# roles can run as separate containers with no shared volume. Writes are create-only and carry a sha256.
# local needs a filesystem with hard links (a Docker named volume, ext4, xfs, APFS, NTFS). On SMB/CIFS, exFAT,
# some NFS servers or a Docker Desktop bind mount from a Windows host, writes fall back to a non-atomic create
# (logged once at the first write).
STORAGE=local
# Leave empty for AWS S3. MinIO: http://minio:9000, Cloudflare R2: https://<account>.r2.cloudflarestorage.com,
# Google Cloud Storage (HMAC keys): https://storage.googleapis.com
S3_ENDPOINT=
# us-east-1 when empty; R2 uses auto.
S3_REGION=
# The credentials need s3:GetObject, s3:GetObjectVersion, s3:PutObject and s3:DeleteObject on the objects and s3:ListBucket on the
# bucket. Without ListBucket a missing key reads as 403 instead of 404 and the store reports an access error.
S3_BUCKET=
# Both or neither; when empty the SDK's default credential chain applies (environment, instance role, ...).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted servers (endpoint/bucket/key URLs).
S3_FORCE_PATH_STYLE=false
# Evidence integrity (ADR-0013). required: the bucket must have versioning enabled; a write that comes back without
# an object version fails. off: for stores without versioning (Cloudflare R2); a replaced object is still detected by
# its sha256 on read, but the original cannot be recovered. The credentials also need s3:GetObjectVersion.
S3_VERSIONING=required
# Browsers upload to a random staging/ key through a single-use presigned POST (5 minutes, at most 25 MB) and
# download through a presigned GET of the recorded version (60 seconds). The bucket needs a CORS rule allowing
# POST and GET from PUBLIC_URL, and a lifecycle rule expiring staging/ objects (and their noncurrent versions) after
# a day. false streams every transfer through the kernel.
S3_PRESIGNED_URLS=true
# The endpoint browsers reach, when it differs from S3_ENDPOINT (for example http://localhost:9000 while the kernel
# uses http://minio:9000). Presigned URLs are signed for this host.
S3_PUBLIC_ENDPOINT=

# Health prober and alerts (`docker compose --profile prober up -d`, or cron: see README). The prober connects as
# crove_prober and alerts when the relay, the job queue or the worker heartbeat falls behind.
# Any URL that accepts a JSON POST: the body has `text` (Slack, Mattermost, Google Chat), `content` (Discord) and a
# structured `crove` object. Empty: alerts are printed to stdout.
ALERT_WEBHOOK_URL=
# Names this deployment in alerts (default: the host of PUBLIC_URL).
ALERT_INSTANCE=
PROBER_INTERVAL_SECONDS=300
PROBER_MAX_OUTBOX_AGE_SECONDS=300
PROBER_MAX_JOB_AGE_SECONDS=900
PROBER_MAX_HEARTBEAT_AGE_SECONDS=120
PROBER_MAX_DEAD_LETTERS=0
