# Copy to .env and change every secret before exposing Crove to anyone else.

# Public URL users open (also used for auth redirects)
PUBLIC_URL=http://localhost:8080
PORT=8080

# Database (PostgreSQL 17)
POSTGRES_PASSWORD=change-me-postgres
CROVE_APP_DB_PASSWORD=change-me-app
CROVE_WORKER_DB_PASSWORD=change-me-worker
CROVE_PROBER_DB_PASSWORD=change-me-prober
# The weekly usage report's login (crove_reporter, `pnpm usage:report`); it may only read counts.
CROVE_REPORTER_DB_PASSWORD=change-me-reporter
AUTH_DB_PASSWORD=change-me-auth
# Reset each pooled connection's session before reuse. Keep true with direct connections; set false only behind a
# transaction-mode pooler (PgBouncer, Supavisor), whose own reset governs there.
DB_RESET_ON_RELEASE=true
# The context token key (#1822, ADR-0028 section 9): base64 of 32 to 64 random bytes. migrate installs it in the
# database and the app signs every user context it enters with it, so a stolen database login cannot act as another
# user. docs/runbooks/context-token-key.md generates it on the server (without printing it), installs and rotates
# it. Empty keeps the older path, for now: a later release requires it.
CROVE_CONTEXT_TOKEN_KEY=
# Realtime invalidation (SSE, /api/stream): each API process LISTENs on one connection to DATABASE_LISTEN_URL, which
# must be direct or session mode (LISTEN does not work through a transaction-mode pooler); unset, DATABASE_URL.
# STREAM_MAX_CONNECTIONS open streams per process (0 turns them off; the app then polls), STREAM_MAX_PER_USER per user,
# and every STREAM_RECHECK_SECONDS (5 to 60) each stream re-checks its session and membership, at most
# STREAM_RECHECK_CONCURRENCY (1 to 10) re-checks at once per process.
# DATABASE_LISTEN_URL=
STREAM_MAX_CONNECTIONS=500
STREAM_MAX_PER_USER=5
STREAM_RECHECK_SECONDS=30
STREAM_RECHECK_CONCURRENCY=3

# Supabase Auth (bundled). At least 32 random characters.
AUTH_JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Require email confirmation (needs a real SMTP server below)
AUTH_AUTOCONFIRM=false
# Anyone who can reach PUBLIC_URL can sign up and use your AI budget. Set true after creating your accounts.
AUTH_DISABLE_SIGNUP=false
# Or keep sign-up open only for some people (checked by Crove before Supabase Auth, AUTH_DISABLE_SIGNUP=false):
# invite_only admits an email with a valid member invite, signing up from its accept link; allowlist admits an email
# at one of AUTH_SIGNUP_ALLOWED_DOMAINS (comma separated, exact domains) or with a valid invite (an invited address
# always signs up from its link). open: anyone.
# While restricted, OAuth, ID-token and Web3 sign-in are refused, and email codes need create_user=false. Under
# allowlist an account may change its email only to an allowed domain.
AUTH_SIGNUP_POLICY=open
AUTH_SIGNUP_ALLOWED_DOMAINS=
# Under allowlist, refusing an allowed-domain sign-up without its invite link tells that the address is invited. Such
# refusals per hour: at most AUTH_SIGNUP_REFUSAL_LIMIT_PER_HOUR per IPv4 address or IPv6 /48, and at most
# AUTH_SIGNUP_REFUSAL_GLOBAL_LIMIT_PER_HOUR for the whole deployment (0: no deployment cap, the default, since a member
# who may invite could fill it and stop plain sign-ups for the whole domain). Past either: 429.
AUTH_SIGNUP_REFUSAL_LIMIT_PER_HOUR=5
AUTH_SIGNUP_REFUSAL_GLOBAL_LIMIT_PER_HOUR=0
# Approving entries and changing members need MFA in the last 5 minutes (policy P11). off works on localhost only.
AUTH_STEP_UP=required
# Emails Supabase Auth sends (sign-up confirmation, recovery, magic link and OTP codes, email change): at most
# AUTH_RATE_LIMIT_EMAIL_SENT per hour for the whole deployment (size it to your SMTP provider's quota), at most
# AUTH_EMAIL_CLIENT_LIMIT_PER_HOUR per client address (IPv6: per /64) and one per recipient every
# AUTH_EMAIL_ADDRESS_INTERVAL_SECONDS. Over a limit: 429. On a public URL Crove refuses to start unless it takes at
# least 10 client addresses to use up the budget (client limit x 10 <= budget). Behind a reverse proxy set
# TRUSTED_PROXY_HOPS, or every client shares the proxy's address and one budget.
AUTH_RATE_LIMIT_EMAIL_SENT=100
AUTH_EMAIL_CLIENT_LIMIT_PER_HOUR=5
AUTH_EMAIL_ADDRESS_INTERVAL_SECONDS=60
# Requests per 5 minutes per client address on sign-up, recovery, OTP, resend and user updates (Supabase Auth).
AUTH_RATE_LIMIT_OTP=30
# How many orgs one account may create: in any 24 hours, and in total (closed orgs count). Over the limit: 429.
ORG_CREATE_LIMIT_PER_DAY=5
ORG_CREATE_LIMIT_TOTAL=20
# How often one org may change its inbound email address: in any 24 hours, and in total. Over the limit: 429.
INBOUND_ROTATE_LIMIT_PER_DAY=3
INBOUND_ROTATE_LIMIT_TOTAL=50
# Member invite mails one address may get in any 24 hours from all orgs together (each org may also send at most 50
# invites, and 3 to one address, in any 24 hours). An org's first invite of an address always passes; repeats over
# the limit: 429.
INVITE_LIMIT_PER_RECIPIENT_PER_DAY=5
# Refused requests per hour that still get their own audit row: per user, and per org. Past them a refusal is only
# counted (the first refusal of each kind is always audited). Each user keeps a reserve the org limit cannot take, and
# security-relevant refusals (FORBIDDEN, MFA step-up, not found) are bounded by the user limit only. The counts are
# kept for REFUSAL_TALLY_RETENTION_DAYS.
REFUSAL_AUDIT_LIMIT_PER_ACTOR=50
REFUSAL_AUDIT_LIMIT_PER_ORG=500
REFUSAL_AUDIT_RESERVE_PER_ACTOR=10
REFUSAL_AUDIT_WINDOW_SECONDS=3600
REFUSAL_TALLY_RETENTION_DAYS=7
# Detective security alerts (#996): every 5 minutes the worker alerts, in its log and to ALERT_WEBHOOK_URL (the
# prober's chat, below) when it is set, when one user acts in more than SECURITY_ALERT_ORG_THRESHOLD orgs or the
# deployment sees more than SECURITY_ALERT_REFUSAL_THRESHOLD refused requests within SECURITY_ALERT_WINDOW_SECONDS, and
# on every owner or admin role given in an org. A lasting signal repeats after SECURITY_ALERT_REPEAT_MINUTES. The
# operational ALERT lines of the worker and the API (a failed export, a stopped sweep, #1993) go to the same webhook,
# once per kind and process in that window.
SECURITY_ALERT_WINDOW_SECONDS=300
SECURITY_ALERT_ORG_THRESHOLD=20
SECURITY_ALERT_REFUSAL_THRESHOLD=500
SECURITY_ALERT_REPEAT_MINUTES=60
# Back-pressure (#894): while the oldest unrelayed outbox event is older than this many seconds, the worker pauses agent,
# bulk mail, archive and retention jobs and logs `[alert] back-pressure on`. Interactive work keeps running.
OUTBOX_LAG_PAUSE_SECONDS=30
# Per-org abuse limits (#675), over any 24 hours: inbound emails, attachment MB, extraction pages and AI cost. An
# email or document over a limit is kept and handled once the org is back under it; the org's owners get one mail per
# limit a day. AI cost is in the unit of the AI prices below (the price of one million input and output tokens of
# AI_MODEL, for example USD); with prices 0 it counts as zero and only the page limit bounds AI use. A deployment
# that sets AI_API_KEY sets a price too: `pnpm pilot:check` fails a public deployment whose key has both prices at 0.
ORG_LIMIT_INBOUND_EMAILS_PER_DAY=300
ORG_LIMIT_ATTACHMENT_MB_PER_DAY=1000
ORG_LIMIT_EXTRACTION_PAGES_PER_DAY=1500
ORG_LIMIT_AI_COST_PER_DAY=20
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# Requests per minute per signed-in user, per API process. Over the limit: 429 with Retry-After. 0 turns it off.
API_RATE_LIMIT_PER_MINUTE=600
# Org exports (offboarding, issue #212): deleted by the worker's daily retention job EXPORT_RETENTION_DAYS after they
# are made (35 to 90). EXPORT_ENCRYPTION_KEY seals them at rest with AES-256-GCM: 32 random bytes as base64 or hex
# (openssl rand -base64 32), the same for API and worker. Required on a public PUBLIC_URL; without it (localhost only)
# exports are stored unencrypted. To rotate, move the old key to EXPORT_ENCRYPTION_KEY_PREVIOUS (comma separated) and
# drop it once its last export expired.
EXPORT_RETENTION_DAYS=35
EXPORT_ENCRYPTION_KEY=
EXPORT_ENCRYPTION_KEY_PREVIOUS=
# The operator's org-purge command (issue #1024, docs/runbooks/org-offboarding.md) runs only this many days after an
# offboarding org's newest export (30 to 3650; the database refuses fewer than 30).
ORG_PURGE_MIN_DAYS=30
# Outbound mail for Supabase Auth (confirmation, magic link, recovery) and Crove (member invites). Port 465 is
# implicit TLS; on other ports with SMTP_USER and SMTP_PASS the server must offer STARTTLS. Without SMTP_HOST (outside
# docker compose, which defaults to Mailpit) Crove sends no invite mail and the inviter passes the link on.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# Crove's own mails (invites) through Resend instead of SMTP: MAIL_PROVIDER=resend with RESEND_API_KEY, and SMTP_FROM
# on a domain verified at Resend. RESEND_WEBHOOK_SECRET (whsec_...) checks Resend's delivery webhooks. Supabase Auth
# keeps the SMTP settings above (Resend also offers SMTP).
MAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Modules to run, comma-separated (kernel is always on). Empty runs every module: kernel,finance,social,crm,notes,
# Social's public routes among them. The API, the worker and the prober all read it. A deployment other people reach
# names its modules: the pilot runs `finance` (compose.pilot.yml below defaults to it, and `pnpm pilot:check` fails a
# public deployment where this is empty). Plain `docker compose up` keeps every module.
CROVE_MODULES=

# The pilot's process layout (docs/runbooks/deploy.md, "The pilot layout"): the API and the worker as two containers,
# the worker's all-org database login and the extraction sandbox out of the API's reach. Uncomment on a deployment
# other people reach: on a deploy host the release ships compose.pilot.yml and listing it here chooses the layout.
# `pnpm pilot:check` fails a public deployment that runs the all-in-one `crove` service. CROVE_ROLES is for a
# deployment without docker compose (Kubernetes, systemd): the roles it starts, each its own process, so pilot-check
# can tell; docker compose reads COMPOSE_FILE instead.
# COMPOSE_FILE=docker-compose.yml:compose.pilot.yml:docker-compose.override.yml:compose.host.yml
# CROVE_ROLES=api,worker
# On a public PUBLIC_URL the kernel refuses the one-container (`all`) role unless you accept it here. Leave it unset for a
# pilot, where api and worker run apart; `pnpm pilot:check` fails it. A laptop (localhost) needs none.
# CROVE_ALLOW_ALL_IN_ONE=true

# Credential key: seals the tokens of connected channels (Facebook Page, Zalo OA...; ADR-0025). 32 bytes as base64,
# for example `openssl rand -base64 32`. It never goes in the database: keep it, and back it up, apart from database
# backups; losing it means every channel must be reconnected (docs/runbooks/credential-key.md). Without
# CREDENTIAL_KEY, CREDENTIAL_KEY_FILE names a file holding the key and is created with a fresh key when missing (the
# docker compose default); api and worker in separate containers must share the same key. CREDENTIAL_KEY_PREVIOUS
# still opens tokens sealed before a rotation.
CREDENTIAL_KEY=
CREDENTIAL_KEY_FILE=.data/credential.key
CREDENTIAL_KEY_PREVIOUS=
# The offline sandbox channel: connect and publish without any platform account.
CHANNEL_SANDBOX=true
# The offline sandbox bank feed (ADR-0039): connect and map test bank accounts without a bank. Local development only:
# the server refuses it on a public PUBLIC_URL, since it writes made-up bank lines.
BANK_FEED_SANDBOX=false
# Signed notices for the sandbox bank feed (POST /api/bank-feed/bank_sandbox/webhook): at least 32 characters; unset, it takes none.
BANK_FEED_SANDBOX_WEBHOOK_SECRET=
# Bluesky: accounts connect with an app password (no app of your own needed). false hides Bluesky.
CHANNEL_BLUESKY=true
# Telegram channels: a bot made with @BotFather, added to the channel as an administrator that may post. false hides
# Telegram.
CHANNEL_TELEGRAM=true
# Mastodon: an account on any instance, with an access token made in its settings (Preferences > Development). false
# hides Mastodon.
CHANNEL_MASTODON=true
# Discord channels: a webhook a server admin makes in the channel's settings (Integrations > Webhooks). true offers
# Discord; false hides it.
CHANNEL_DISCORD=true
# WordPress: a self-hosted or WordPress.com Business site, with an application password made in the user's profile
# (Users > Profile > Application Passwords). false hides WordPress.
CHANNEL_WORDPRESS=true
# Facebook Pages and Instagram: your Meta app (developers.facebook.com, with the Facebook Login product). Add
# PUBLIC_URL/channels/oauth/facebook_page/callback and .../instagram/callback as valid OAuth redirect URIs. Instagram fetches
# images from presigned storage URLs, so it needs STORAGE=s3 with a public endpoint. In development mode only people
# with a role on the app can connect their Pages; others need App Review. Leave empty to hide Facebook Pages.
CHANNEL_META_APP_ID=
CHANNEL_META_APP_SECRET=
# Zalo OA: your Zalo app (developers.zalo.me) linked to the OA, with PUBLIC_URL/channels/oauth/zalo_oa/callback as its
# callback URL. Article covers are fetched from presigned storage URLs, so posting needs STORAGE=s3 with a public endpoint.
CHANNEL_ZALO_APP_ID=
CHANNEL_ZALO_APP_SECRET=
# Threads: the Threads use case of your Meta app (its own app id), with PUBLIC_URL/channels/oauth/threads/callback as a
# redirect URI. Images are fetched from presigned storage URLs (STORAGE=s3); text posts work everywhere.
CHANNEL_THREADS_APP_ID=
CHANNEL_THREADS_APP_SECRET=
# LinkedIn: a self-serve app with the products Share on LinkedIn and Sign In with LinkedIn using OpenID Connect, and
# PUBLIC_URL/channels/oauth/linkedin/callback as a redirect URL. Tokens last 60 days with no refresh: members reconnect.
CHANNEL_LINKEDIN_CLIENT_ID=
CHANNEL_LINKEDIN_CLIENT_SECRET=
# true once the LinkedIn app has member post analytics (r_member_postAnalytics): post counts in reports.
CHANNEL_LINKEDIN_ANALYTICS=false
# true once LinkedIn has approved an app for the Community Management API: Crove then offers LinkedIn Page, which
# connects each Company Page the member administers (w_organization_social, r_organization_admin) and posts as the page.
# Add PUBLIC_URL/channels/oauth/linkedin_page/callback as a redirect URL. Leave it false otherwise: LinkedIn refuses a
# sign-in that asks for a scope the app lacks. Page tokens last 60 days too: members reconnect.
CHANNEL_LINKEDIN_ORGANIZATIONS=false
# The Company Pages app, when it is not the member app above. LinkedIn grants the Community Management API only to an
# app with no other product, so a deployment that also posts as members needs a second app. Unset: pages use the
# member app.
CHANNEL_LINKEDIN_PAGE_CLIENT_ID=
CHANNEL_LINKEDIN_PAGE_CLIENT_SECRET=
# YouTube: a Google Cloud project with the YouTube Data API v3 and an OAuth web client whose redirect URI is
# PUBLIC_URL/channels/oauth/youtube/callback. The default quota allows about 100 uploads a day for the whole project.
CHANNEL_GOOGLE_CLIENT_ID=
CHANNEL_GOOGLE_CLIENT_SECRET=
# Google Business Profile posts with the same project, once Google approves it for the Business Profile APIs (the
# Basic API Access form: a verified profile active for 60 days with a website; until then the APIs answer nothing).
# Add PUBLIC_URL/channels/oauth/google_business/callback as a redirect URI, then set true.
CHANNEL_GOOGLE_BUSINESS=false
# Outside calendars (Settings, "Lịch ngoài"): a member connects Google Calendar so its busy times (start and end only)
# block booking slots. A separate OAuth web client with the Calendar API enabled and the scopes openid, email and
# calendar.freebusy; redirect URI PUBLIC_URL/calendar/oauth/google_calendar/callback (docs/runbooks/calendar-oauth.md).
# Set both or neither; with neither the connect button is hidden.
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
# TikTok: an app with Login Kit and the Content Posting API (Direct Post), and PUBLIC_URL/channels/oauth/tiktok/callback
# as a redirect URI. Until TikTok audits the app, posts can only be private (SELF_ONLY).
CHANNEL_TIKTOK_CLIENT_KEY=
CHANNEL_TIKTOK_CLIENT_SECRET=
# true when the TikTok app also has the Display API: Crove then asks for video.list and reads each post's views, likes,
# comments and shares. Leave it false otherwise: TikTok refuses a sign-in that asks for a scope the app lacks.
CHANNEL_TIKTOK_VIDEO_LIST=false
# true when the TikTok app is also approved for video.upload (the Content Posting API's Upload): Crove then asks for it
# and offers "Send to the TikTok app", which puts a video in the creator's TikTok inbox as a draft they finish and post
# in TikTok (it works for an app TikTok has not audited). Reconnect TikTok channels after turning it on. Leave it false
# otherwise: TikTok refuses a sign-in that asks for a scope the app lacks.
CHANNEL_TIKTOK_INBOX=false
# X: an app in the X developer console with OAuth 2.0 on (type Web App, a confidential client), read and write
# permissions, and PUBLIC_URL/channels/oauth/x/callback as a callback URL. X bills each post to the app's account.
CHANNEL_X_CLIENT_ID=
CHANNEL_X_CLIENT_SECRET=
# true to read X post counts in the metrics sweep; X bills every post read.
CHANNEL_X_METRICS=false
# Pinterest: an app at developers.pinterest.com with PUBLIC_URL/channels/oauth/pinterest/callback as a redirect URI and
# the boards:read, pins:read, pins:write and user_accounts:read scopes. Each board of an account becomes a channel.
CHANNEL_PINTEREST_APP_ID=
CHANNEL_PINTEREST_APP_SECRET=

# AI for PDF and image invoices: any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, DOS.AI, ...).
# Leave empty to read e-invoice XML only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# true when AI_MODEL reads images (a vision model): the composer may suggest an image's alt text (#817, #1121).
# The image goes only to AI_BASE_URL and is never logged; false refuses the suggestion (AI_VISION_OFF).
AI_VISION=false

# crove-extract, the parsing sandbox the worker sends files and emails to. docker compose sets it; for
# `pnpm dev`, the extract dev server listens here.
EXTRACT_URL=http://127.0.0.1:8090
# Extract jobs the worker runs at once (#2119, 1 to 8). Unset: 4, or EXTRACT_CONCURRENCY when that is lower (1 outside
# docker compose until you set it, which is the sandbox's own default). Each job reads
# one document, and for a PDF or a photo waits 10 to 20 s for the AI, so a ZIP of 200 documents takes about 12 minutes
# with 4 instead of 50 with 1. Keep it within your AI provider's rate limit (docs/runbooks/extract-sizing.md).
EXTRACT_WORKER_CONCURRENCY=
# The sandbox's parser slots (1 to 8): docker compose gives the same value to crove-extract and the worker, which never
# runs more jobs than slots. Memory and CPUs of crove-extract in docker-compose.yml are sized for 4. Where the sandbox
# runs apart from compose (pnpm dev, another orchestrator), set the same value on both, or both stay at 1.
EXTRACT_CONCURRENCY=4
# Times a failing AI call is sent again (429, 5xx, network) before the document's job fails and is retried later (0 to 5).
# The whole call stops at 120 s, retries included; this bounds the provider calls one failing document costs to
# 1 + AI_MAX_RETRIES.
AI_MAX_RETRIES=1

# The product name users see (#1040, #1045): in the app, the browser tab title, the installed app's name (#1691), the
# sender name and texts of mails, the authenticator app entry, the status and bio pages, the calendar feed, chat
# alerts, exported files and their names.
# 1 to 40 characters: letters, digits, spaces and . , & ' + _ ! ( ) -. Empty keeps "Ludy". Code, database schemas,
# logs, the AGPL source notice and the software name in HTKK XML keep "Crove" whatever it is.
BRAND_NAME=

# The app's "Góp ý / Hỗ trợ" (feedback and support) link: an https: page such as a chat group, or a mailto: address
# (mailto:support@example.com). Leave empty to hide the link. Browsers can read it, so put nothing secret in it.
SUPPORT_URL=
# Terms of service and privacy notice linked at sign-up and invite acceptance (#688): https: pages you publish
# (drafts to start from: docs/legal/). Unset hides the line.
TERMS_URL=
PRIVACY_URL=

# Stock photos in the Social media library and the composer (#1106): the API key of a free Pexels account
# (https://www.pexels.com/api/). Members search Pexels and save a photo into the library with its photographer's credit.
# Leave empty to turn it off: no Pexels call is made. The key stays on the server.
MEDIA_PEXELS_API_KEY=

# Browser push for the Social notifications someone must act on (#1238): the deployment's VAPID key pair (RFC 8292) and
# a contact for the push services (mailto:you@example.com or an https: URL). Make a pair with
# `docker compose run --rm --no-deps crove vapid-keys`. Set all three or none: empty, the app offers no push and
# nothing is sent. Keep the private key secret; a new pair ends every subscription (members turn push on again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Onboarding by tax code: the app's "Tra cứu" button fills a new org's name and address from a public tax registry. An
# https URL template with {taxCode}, answering in the VietQR business shape, for example
# https://api.vietqr.io/v2/business/{taxCode}. Leave empty to turn the lookup off: it sends the tax codes your users
# type to that provider.
TAX_CODE_LOOKUP_URL=

# Assisted purchase-invoice sync from the tax portal (issue #325, docs/integrations/tax-portal-sync.md): on the
# reconciliation screen the accountant types the client's hoadondientu.gdt.gov.vn password and solves the portal's
# CAPTCHA, and Crove fetches that period's purchase list and invoice XML. Off unless true: it logs in to a government
# portal on a client's behalf, with the client's consent. Crove never stores the password and never solves the CAPTCHA.
# Needs the credential key (CREDENTIAL_KEY or CREDENTIAL_KEY_FILE).
TAX_PORTAL_SYNC=false
# One deadline in seconds for each list or XML step of a sync, all its portal requests together (30 to 300).
TAX_PORTAL_STEP_SECONDS=90

# Inbound email: invoices sent to <org token>@INBOUND_DOMAIN are delivered by your mail worker
# to POST /api/inbound/email with "Authorization: Bearer <INBOUND_SECRET>" (raw MIME body).
INBOUND_DOMAIN=
# At least 32 random characters.
INBOUND_SECRET=
# During a rotation only: the old value, still accepted until the mail worker sends the new one; then empty it
# (docs/runbooks/secret-rotation.md, section 2).
INBOUND_SECRET_PREVIOUS=

# Cloudflare Turnstile on the public booking form (crm module): both or neither. With them the booking page shows the
# widget and the kernel checks each request's token with Cloudflare; without them nothing changes.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Behind a TLS reverse proxy: how many proxies append to X-Forwarded-For (used for the sign-in, sign-up, recovery
# and email rate limits, which are per client address).
TRUSTED_PROXY_HOPS=0

# File storage: local (the `files` volume) or s3 (any S3-compatible store). With s3 the api and worker
# roles can run as separate containers with no shared volume. Writes are create-only and carry a sha256.
# local needs a filesystem with hard links (a Docker named volume, ext4, xfs, APFS, NTFS). On SMB/CIFS, exFAT,
# some NFS servers or a Docker Desktop bind mount from a Windows host, writes fall back to a non-atomic create
# (logged once at the first write).
STORAGE=local
# Leave empty for AWS S3. MinIO: http://minio:9000, Cloudflare R2: https://<account>.r2.cloudflarestorage.com,
# Google Cloud Storage (HMAC keys): https://storage.googleapis.com
S3_ENDPOINT=
# us-east-1 when empty; R2 uses auto.
S3_REGION=
# The credentials need s3:GetObject, s3:GetObjectVersion, s3:PutObject and s3:DeleteObject on the objects and s3:ListBucket on the
# bucket. Without ListBucket a missing key reads as 403 instead of 404 and the store reports an access error.
S3_BUCKET=
# Both or neither; when empty the SDK's default credential chain applies (environment, instance role, ...).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted servers (endpoint/bucket/key URLs).
S3_FORCE_PATH_STYLE=false
# Evidence integrity (ADR-0013). required: the bucket must have versioning enabled; a write that comes back without
# an object version fails. off: for stores without versioning (Cloudflare R2); a replaced object is still detected by
# its sha256 on read, but the original cannot be recovered. The credentials also need s3:GetObjectVersion.
S3_VERSIONING=required
# Fiscal year archive packages (#922, docs/runbooks/year-archive.md): with STORAGE=s3 and this above 0, every part
# under archive/ is written with Object Lock in ARCHIVE_LOCK_MODE for this many days (3653 covers the 10 years of
# Accounting Law 88/2015 Art. 41). The bucket must have Object Lock enabled and the credentials need s3:PutObjectRetention
# (to lock a part stored before the lock was set). 0: the bucket's default retention, if any.
S3_ARCHIVE_LOCK_DAYS=0
# Retention holds on evidence files (#1009, docs/runbooks/evidence-holds.md): with STORAGE=s3 the worker holds the
# original file of every posted invoice for this many days from its posting, in GOVERNANCE mode. The bucket needs
# Object Lock, and the credentials s3:GetBucketObjectLockConfiguration, s3:GetObjectRetention and s3:PutObjectRetention;
# on a bucket without Object Lock the worker logs one ALERT a day and posting goes on. Raising it lengthens existing
# holds; lowering it never shortens one. 0: no holds. Local disk has none.
EVIDENCE_LOCK_DAYS=3650
# The WORM fact stream (plan §4.10, #891, docs/runbooks/worm-archive.md): the worker anchors the hash of every audit
# event and journal entry, and verifies them nightly. local: read-only files under ARCHIVE_DIR (the `archive` volume in
# compose). s3: ARCHIVE_S3_BUCKET, a bucket created with Object Lock, reached with the S3_* settings above; the worker
# refuses to start if it has no Object Lock. Objects are locked in ARCHIVE_LOCK_MODE (GOVERNANCE while trying it,
# COMPLIANCE in production) for ARCHIVE_RETENTION_DAYS.
ARCHIVE_STORE=local
ARCHIVE_S3_BUCKET=
ARCHIVE_LOCK_MODE=GOVERNANCE
ARCHIVE_RETENTION_DAYS=3650
# Rows are archived this long after they are written at the earliest (60 to 86400), so open transactions are not cut off.
ARCHIVE_LAG_SECONDS=600
# After a restore, the nightly verifier alerts on every run, for this many days after it was written, about the restore
# acknowledgement in force (docs/runbooks/worm-archive.md, "After a restore").
ARCHIVE_RESTORE_ALERT_DAYS=14
# Browsers upload to a random staging/ key through a single-use presigned POST (5 minutes, at most 25 MB) and
# download through a presigned GET of the recorded version (60 seconds). The bucket needs a CORS rule allowing
# POST and GET from PUBLIC_URL, and a lifecycle rule expiring staging/ objects (and their noncurrent versions) after
# a day. The worker's daily job also deletes staging/ objects older than an hour, which frees the space on an
# unversioned bucket only; on a versioned one (the default) the lifecycle rule is still required. false streams every
# transfer through the kernel.
# Cloudflare R2: set false. R2 does not accept presigned POST uploads, and Crove refuses to start on an R2 endpoint
# with true.
S3_PRESIGNED_URLS=true
# The endpoint browsers reach, when it differs from S3_ENDPOINT (for example http://localhost:9000 while the kernel
# uses http://minio:9000). Presigned URLs are signed for this host. On a public PUBLIC_URL it must be https (Crove
# refuses to start otherwise): browsers send files there and the app's CSP allows it in connect-src.
S3_PUBLIC_ENDPOINT=
# Staged upload completions one API process runs at once; each holds the file (up to 25 MB) in memory. Past it, and
# past half of it for one user, a completion answers 503 with Retry-After and the app retries. Uploads sent through
# the kernel (POST /api/files) get twice as many slots on the same terms.
UPLOAD_COMPLETE_CONCURRENCY=4
# Presigned upload grants one user may open per org in any rolling minute (counted in the database).
UPLOAD_BEGIN_LIMIT_PER_MINUTE=20

# Health prober and alerts (`docker compose --profile prober up -d`, or cron: see README). The prober connects as
# crove_prober and alerts when the relay, the job queue or the worker heartbeat falls behind.
# A Slack incoming webhook, a Discord webhook, Telegram's https://api.telegram.org/bot<token>/sendMessage, or any URL
# that accepts a JSON POST (generic: `text`, `content` and a structured `crove` object). Empty: alerts are printed to
# stdout. Check it with `pnpm alert:test` (README, "Monitoring and alerts").
ALERT_WEBHOOK_URL=
# auto (by the webhook host), slack, discord, telegram or generic.
ALERT_WEBHOOK_FORMAT=auto
# Telegram only: the chat the bot posts to (a numeric id, negative for groups and channels, or @channelname).
ALERT_TELEGRAM_CHAT_ID=
# While a problem lasts, notify again every this many minutes (0: only when it starts, changes or ends).
ALERT_REPEAT_MINUTES=60
# Names this deployment in alerts (default: the host of PUBLIC_URL).
ALERT_INSTANCE=
# An outside heartbeat monitor's ping URL (a dead man's switch: Healthchecks.io, Uptime Kuma push, Better Stack). The
# prober pings it after each probe that read the database and delivered every alert it owed, so the monitor pages
# when the prober, the host, the database or the alert path stops. Set its period to PROBER_INTERVAL_SECONDS
# (docs/runbooks/alerts.md).
PROBER_HEARTBEAT_URL=
# The public status page PUBLIC_URL/status (#678): set it to /data/status/status.json (the `status` volume) and the
# prober writes each result there, the API draws the page from it and the app links to it. Needs the prober running;
# the page shows only which functions work, nothing about an org. Leave empty for no page.
STATUS_FILE=
PROBER_INTERVAL_SECONDS=300
PROBER_MAX_OUTBOX_AGE_SECONDS=300
PROBER_MAX_JOB_AGE_SECONDS=900
PROBER_MAX_HEARTBEAT_AGE_SECONDS=120
PROBER_MAX_DEAD_LETTERS=0
# Supabase Auth's health (#1994): the prober asks PROBER_AUTH_URL/health and alerts after PROBER_AUTH_MISSES failed
# answers in a row (0: off). Compose defaults it to the kernel's /auth/v1 proxy; Auth hosted elsewhere: its /auth/v1 URL,
# with PUBLIC_AUTH_ANON_KEY for hosted Supabase. From cron without it: PUBLIC_AUTH_URL, else PUBLIC_URL/auth/v1.
PROBER_AUTH_URL=
PROBER_AUTH_MISSES=2
# The WORM archive (#1997): alert when the nightly verification is older than this, or the oldest row not yet archived
# is; 0 turns either off. The archiver waits ARCHIVE_LAG_SECONDS on purpose, so keep the lag limit well above it: empty,
# it is the larger of 3600 and ARCHIVE_LAG_SECONDS plus 900.
PROBER_MAX_ARCHIVE_VERIFY_AGE_SECONDS=93600
PROBER_MAX_ARCHIVE_LAG_SECONDS=
# The verification heartbeat outside the database (#2082): the prober reads the newest marker the nightly verification
# wrote to the archive store (ARCHIVE_STORE, ARCHIVE_DIR or ARCHIVE_S3_BUCKET, S3_ENDPOINT, S3_REGION and
# S3_FORCE_PATH_STYLE above) and alerts when the store wrote it longer ago than this; 0 turns it off. With
# ARCHIVE_STORE=s3 and static keys, give the prober a read-only key of its own (s3:ListBucket, s3:ListBucketVersions,
# s3:GetObject on verify/* and chain/*), both variables or neither. With neither, the marker check is disabled and
# reports why, unless PROBER_ARCHIVE_S3_DEFAULT_CHAIN=true opts in to the SDK's default credential chain (an instance or
# task role that only reads: the prober cannot tell, and the chain may resolve to a role that writes the archive). The
# prober never uses S3_ACCESS_KEY_ID or S3_SECRET_ACCESS_KEY, the worker's key: with S3_ACCESS_KEY_ID in its
# environment and no pair of its own, the marker check is disabled and reports why.
PROBER_MAX_ARCHIVE_MARKER_AGE_SECONDS=93600
PROBER_ARCHIVE_S3_ACCESS_KEY_ID=
PROBER_ARCHIVE_S3_SECRET_ACCESS_KEY=
PROBER_ARCHIVE_S3_DEFAULT_CHAIN=
# AI document readings whose every attempt failed (#1998: the provider refused or did not answer, the parser sandbox
# was down): more than this many within the window alert; 0 turns it off. Unreadable documents never count.
PROBER_MAX_EXTRACTION_FAILURES=2
PROBER_EXTRACTION_WINDOW_SECONDS=3600

# Weekly usage report (`pnpm usage:report`, or `docker compose run --rm usage usage-report`; README, "Weekly usage
# report"). Connects as crove_reporter, which may only read counts from crove_kernel.usage_weekly(). Compose builds
# the URL itself; from a checkout set it here. With --post it also sends a summary of the last complete week to
# ALERT_WEBHOOK_URL above (deployment totals only), and fails without it (docs/runbooks/alerts.md, "Weekly usage
# summary").
# REPORTER_DATABASE_URL=postgres://crove_reporter:change-me-reporter@localhost:5432/postgres

# Backups (tools/backup/backup.sh, run nightly by cron or a systemd timer on the host; restore with
# tools/backup/restore.sh; docs/runbooks/backup-and-restore.md). Each run is a pg_dump of the whole database and a copy
# of every file blob, with checksums, written to BACKUP_DIR and then copied to the bucket below. A failed run exits 1
# and alerts through the prober (ALERT_WEBHOOK_URL above); BACKUP_ALERT=off turns that off.
# Where runs are written on this server (default: .data/backups in the checkout).
BACKUP_DIR=/var/backups/crove
# Days a run is kept, here and in the bucket. BACKUP_LOCAL_KEEP_DAYS keeps fewer here when the bucket is set.
BACKUP_KEEP_DAYS=30
BACKUP_LOCAL_KEEP_DAYS=7
# The second location: any S3-compatible bucket, apart from the one the stack stores files in (another provider or
# account), private, ideally versioned. Empty BACKUP_S3_ENDPOINT keeps runs in BACKUP_DIR only, which is for
# development: on a deployment (PUBLIC_URL not on localhost) such a run fails and alerts. The keys need to list, read,
# write and delete under BACKUP_S3_PREFIX. Org blobs are uploaded once each and shared by the runs that list them.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=crove
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Seals everything that goes to the bucket (AES-256-GCM), so the bucket alone does not expose the books: 32 random
# bytes as base64 or hex (openssl rand -base64 32), its own key, not EXPORT_ENCRYPTION_KEY. Keep a copy in your secret
# store apart from the bucket: without it no sealed run opens. After a rotation the old key goes in _PREVIOUS until
# the runs it sealed are older than BACKUP_KEEP_DAYS.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_PREVIOUS=
# An outside heartbeat monitor's ping URL (period 1 day, grace 2 hours), pinged after each complete run, so a backup
# that never runs (the timer disabled, the server off) pages the owner.
BACKUP_HEARTBEAT_URL=
BACKUP_ALERT=prober
# Continuous WAL archiving and point-in-time recovery (#2120, docs/runbooks/backup-and-restore.md, "Point in time
# recovery"): tools/backup/compose.wal.yml in COMPOSE_FILE, then `tools/backup/wal.sh setup` once. Every finished WAL
# segment goes to the backup bucket (BACKUP_S3_BUCKET, under <BACKUP_S3_PREFIX>/wal), sealed with WAL_ENCRYPTION_KEY: 32 random
# bytes as base64 (openssl rand -base64 32), its own key, kept apart from the bucket and never rotated in place.
WAL_ENCRYPTION_KEY=
# The database container's own key pair for the bucket, never BACKUP_S3_ACCESS_KEY_ID: it can write and delete every nightly
# run, and anyone who reaches the postgres user reads this container's environment. Scope it to <BACKUP_S3_PREFIX>/wal/*
# (list, get, put, delete).
WAL_S3_ACCESS_KEY_ID=
WAL_S3_SECRET_ACCESS_KEY=
# The host of BACKUP_S3_ENDPOINT without https:// (pgBackRest takes a host name), its port if not 443, the region, and
# `path` for MinIO and most S3-compatible stores (`host` for AWS S3).
WAL_S3_ENDPOINT=
WAL_S3_PORT=443
WAL_S3_REGION=us-east-1
WAL_S3_URI_STYLE=host
# Seconds a write may wait before its WAL segment is closed and pushed (10 to 3600): the recovery point objective is that
# plus the upload. Base backups kept: full ones, and differential ones since the last full one.
WAL_ARCHIVE_TIMEOUT=60
WAL_RETENTION_FULL=4
WAL_RETENTION_DIFF=6
# The prober alerts when a finished WAL segment has waited longer than this to be pushed (0: off; nothing is checked while
# archive_mode is off).
PROBER_MAX_WAL_ARCHIVE_AGE_SECONDS=600
# ... or when this many finished segments wait at once (archiving that pushes, but slower than the database writes; 0: off).
PROBER_MAX_WAL_PENDING_SEGMENTS=20
