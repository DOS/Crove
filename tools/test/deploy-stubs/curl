#!/usr/bin/env bash
# A stand-in for curl in tools/test/deploy.test.ts: answers the kernel's endpoints. The release that runs is the
# image in $STUB_DEPLOY_DIR/docker-compose.override.yml; when it holds $STUB_BAD_DIGEST, or STUB_READYZ_FAIL is
# set, /readyz answers 503. STUB_NO_BUNDLE (always) and STUB_NO_BUNDLE_DIGEST (while that image runs) serve a
# sign-in page without its script.
#
# The account step of the smoke test (#690): every command line goes to $STUB_LOG.argv, so a test can check that no
# secret is on one; the sign-in body read from stdin goes to $STUB_LOG.signin, the uploaded file to
# $STUB_LOG.upload, an RPC body to $STUB_LOG.rpc. STUB_SIGNIN_FAIL refuses the sign-in, STUB_FILE_STATUS sets the
# uploaded file's status (default proposed), STUB_REJECT_FAIL fails the rejection.
set -euo pipefail

printf '%s\n' "$*" >>"$STUB_LOG.argv"
out='' url='' headers='' data='' form=''
while (($# > 0)); do
  case "$1" in
    --output)
      out="$2"
      shift 2
      ;;
    --max-time | --request)
      shift 2
      ;;
    --header)
      if [[ "$2" == @* ]]; then headers="$(cat "${2#@}")"; fi
      shift 2
      ;;
    --data-binary)
      if [ "$2" = @- ]; then data="$(cat)"; else data="$2"; fi
      shift 2
      ;;
    --form)
      form="$2"
      shift 2
      ;;
    http://* | https://*)
      url="$1"
      shift
      ;;
    *) shift ;;
  esac
done
printf 'curl %s\n' "$url" >>"$STUB_LOG"

running="$(cat "$STUB_DEPLOY_DIR/docker-compose.override.yml" 2>/dev/null || true)"
status=200 body=''
case "$url" in
  */healthz) body='{"ok":true}' ;;
  */readyz)
    if [ -n "${STUB_READYZ_FAIL:-}" ] || { [ -n "${STUB_BAD_DIGEST:-}" ] && [[ "$running" == *"$STUB_BAD_DIGEST"* ]]; }; then
      status=503 body='{"ready":false,"reason":"schema"}'
    else
      body='{"ready":true}'
    fi
    ;;
  */api/config) body='{"authUrl":"http://127.0.0.1:18080/auth/v1","modules":[]}' ;;
  */auth/v1/health) body='{"name":"GoTrue"}' ;;
  */login)
    if [ -n "${STUB_NO_BUNDLE:-}" ] || { [ -n "${STUB_NO_BUNDLE_DIGEST:-}" ] && [[ "$running" == *"$STUB_NO_BUNDLE_DIGEST"* ]]; }; then
      body='<div id="root"></div>'
    else
      body='<div id="root"></div><script type="module" crossorigin src="/assets/index-abc123.js"></script>'
    fi
    ;;
  */assets/index-abc123.js) body='console.log(1)' ;;
  */auth/v1/token\?grant_type=password)
    printf '%s' "$data" >"$STUB_LOG.signin"
    if [ -n "${STUB_SIGNIN_FAIL:-}" ]; then status=400 body='{"error":"invalid_grant"}'; else body='{"access_token":"stub-access-token","token_type":"bearer"}'; fi
    ;;
  */api/files | */api/rpc/*)
    if [[ "$headers" != *'authorization: Bearer stub-access-token'* || "$headers" != *'x-crove-org: crove-smoke'* ]]; then
      status=401 body='{"code":"UNAUTHENTICATED"}'
    elif [[ "$url" == */api/files ]]; then
      file="${form#file=@}"
      cp "${file%%;*}" "$STUB_LOG.upload"
      body='{"files":[{"fileId":"file-1","duplicate":false}]}'
    elif [[ "$url" == */api/rpc/files/recent ]]; then
      case "${STUB_FILE_STATUS:-proposed}" in
        proposed) mine='{"id":"file-1","status":"proposed","proposalId":"proposal-1","error":null}' ;;
        failed) mine='{"id":"file-1","status":"failed","proposalId":null,"error":"UNREADABLE"}' ;;
        *) mine="{\"id\":\"file-1\",\"status\":\"$STUB_FILE_STATUS\",\"proposalId\":null,\"error\":null}" ;;
      esac
      body="{\"json\":[{\"id\":\"file-0\",\"status\":\"proposed\",\"proposalId\":\"proposal-0\",\"error\":null},$mine]}"
    elif [[ "$url" == */api/rpc/inbox/reject ]]; then
      printf '%s' "$data" >"$STUB_LOG.rpc"
      if [ -n "${STUB_REJECT_FAIL:-}" ]; then status=500 body='{"code":"INTERNAL"}'; else body='{"json":{"ok":true}}'; fi
    else
      status=404
    fi
    ;;
  *) status=404 ;;
esac

if [ -n "$out" ]; then printf '%s' "$body" >"$out"; else printf '%s' "$body"; fi
# curl --fail exits 22 on an HTTP error.
if ((status >= 400)); then exit 22; fi
exit 0
